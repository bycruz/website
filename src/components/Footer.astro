---
import { Icon } from "astro-icon/components";
import { linkedin, x } from "../data/info";
import { github } from "../data/info";
import { email } from "../data/info";
import { rss } from "../data/info";

type LinkInfo = { to: string; label: string } & (
	| { text: string }
	| { icon: string }
);

const links = [
	{ to: x, text: "𝕏", label: "𝕏" },
	{
		to: linkedin,
		icon: "mdi:linkedin",
		label: "LinkedIn",
	},
	{
		to: github,
		icon: "mdi:github",
		label: "Github",
	},
	{
		to: `mailto:${email}`,
		icon: "mdi:email",
		label: "Mail",
	},
	{
		to: rss,
		icon: "mdi:rss",
		label: "RSS Feed",
	},
] as LinkInfo[];
---

<footer class="px-4 py-6 border-t border-black/10 dark:border-white/10 w-full">
	<div class="flex flex-row gap-1 items-center justify-center">
		{
			links.map((link) => (
				<a
					class="text-2xl p-4 text-black/50 dark:text-white/50 transition-colors duration-200 hover:text-black dark:hover:text-white"
					href={link.to}
					aria-label={link.label}
				>
					{"icon" in link ? (
						<Icon name={link.icon} size="32" />
					) : (
						link.text
					)}
				</a>
			))
		}
	</div>
</footer>
