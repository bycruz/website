---
import Logo from "./Logo.astro";
import { Icon } from "astro-icon/components";

const links = [
	{ name: "Projects", to: "/projects", icon: "mdi:flask" },
	{ name: "Posts", to: "/posts", icon: "mdi:paper" },
	{ name: "About", to: "/about", icon: "mdi:about" },
];

const currentPath = Astro.url.pathname;
---

<nav
	class="sticky z-10 top-0 bg-slate-50/90 dark:bg-[#0f1115]/90 flex flex-row justify-center w-full px-4 py-3 border-b border-black/10 dark:border-white/10 backdrop-blur-sm"
>
	<div
		class="w-full max-w-6xl px-4 sm:px-8 lg:px-12 flex flex-row justify-between items-center"
	>
		<Logo />

		<div class="hidden md:flex flex-row gap-2">
			{
				links.map((link) => (
					<a
						href={link.to}
						class={`px-3 py-2 lg:px-5 lg:py-3 text-base text-gray-700 dark:text-gray-300 hover:text-black dark:hover:text-white transition-colors duration-200 rounded-md ${currentPath.startsWith(link.to) ? "text-black dark:text-white bg-black/5 dark:bg-white/5" : ""}`}
					>
						<span class="flex flex-row items-center gap-2 font-semibold">
							{link.name}
							<Icon
								class="inline size-4"
								size="16"
								name={link.icon}
							/>
						</span>
					</a>
				))
			}
		</div>

		<button
			id="theme-toggle"
			class="cursor-pointer p-2 rounded-md text-gray-700 dark:text-gray-300 hover:text-black dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-200"
			aria-label="Toggle theme"
		>
			<svg id="theme-icon-moon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
			</svg>
			<svg id="theme-icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
			</svg>
		</button>

		<div class="md:hidden">
			<input type="checkbox" id="mobile-menu-toggle" class="hidden" />
			<label
				for="mobile-menu-toggle"
				class="cursor-pointer block w-6 h-6 text-gray-700 dark:text-gray-300 hover:text-black dark:hover:text-white transition-colors duration-200"
			>
				<svg
					class="burger-icon w-6 h-6"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>

				<svg
					class="cross-icon w-6 h-6"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</label>

			<div
				class="mobile-menu absolute top-full left-0 right-0 bg-slate-50/95 dark:bg-[#0f1115]/95 border-b border-black/10 dark:border-white/10 backdrop-blur-sm"
			>
				<div class="flex flex-col">
					{
						links.map((link, index) => (
							<a
								href={link.to}
								class={`px-4 py-4 text-base text-gray-700 dark:text-gray-300 hover:text-black dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 bg-transparent transition-colors duration-200 border-b border-b-black/10 dark:border-b-white/10 last:border-b-0 mobile-menu-item relative ${currentPath === link.to ? "bg-black/5 dark:bg-white/5 text-black dark:text-white" : ""}`}
								style={`animation-delay: ${index * 0.1}s;`}
							>
								<span class="flex flex-row items-center gap-3 font-semibold">
									<Icon
										class="inline size-5"
										size="20"
										name={link.icon}
									/>
									{link.name}
								</span>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</div>
</nav>

<script>
	function setupThemeToggle() {
		const button = document.getElementById("theme-toggle");
		const moonIcon = document.getElementById("theme-icon-moon");
		const sunIcon = document.getElementById("theme-icon-sun");

		if (!button || !moonIcon || !sunIcon) return;

		function updateIcons() {
			const isDark = document.documentElement.classList.contains("dark");
			moonIcon.classList.toggle("hidden", isDark);
			sunIcon.classList.toggle("hidden", !isDark);
		}

		updateIcons();

		button.addEventListener("click", () => {
			const isDark = document.documentElement.classList.toggle("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
			updateIcons();
		});
	}

	setupThemeToggle();
	document.addEventListener("astro:after-swap", setupThemeToggle);
</script>

<style>
	@keyframes slideDown {
		from {
			opacity: 0;
			transform: translateY(-20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fadeInItem {
		from {
			opacity: 0;
			transform: translateX(-20px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	.mobile-menu {
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		transform: translateY(-20px);
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.mobile-menu-item {
		opacity: 0;
		transform: translateX(-20px);
	}

	#mobile-menu-toggle:checked ~ .mobile-menu {
		max-height: 500px;
		opacity: 1;
		transform: translateY(0);
	}

	#mobile-menu-toggle:checked ~ .mobile-menu .mobile-menu-item {
		animation: fadeInItem 0.4s ease-out forwards;
	}

	.burger-icon {
		display: block;
	}

	.cross-icon {
		display: none;
	}

	#mobile-menu-toggle:checked + label .burger-icon {
		display: none;
	}

	#mobile-menu-toggle:checked + label .cross-icon {
		display: block;
	}
</style>
