---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { email, linkedin, x, github } from "../data/info";
---

<Layout>
	<div class="py-12 pb-20 w-full max-w-2xl mx-auto">
		<h1 class="text-3xl font-bold mb-2">About</h1>
		<p class="text-gray-600 dark:text-gray-400 mb-10">
			A bit more about who I am.
		</p>

		<div class="flex flex-col gap-8">
			<div>
				<h2
					class="text-gray-900 dark:text-gray-100 font-semibold text-xl mb-2"
				>
					<span class="waving-hand">👋</span> I'm David
				</h2>
				<p class="leading-relaxed text-gray-700 dark:text-gray-300">
					I write software. I work across the stack but lean towards
					lower-level stuff: Rust, C, graphics, tooling. I care about
					correctness and performance.
				</p>
			</div>

			<div>
				<h2
					class="text-gray-900 dark:text-gray-100 font-semibold text-xl mb-2"
				>
					What I Do
				</h2>
				<p class="leading-relaxed text-gray-700 dark:text-gray-300">
					Personal projects and contract work. You can see what I've
					built on the <a
						href="/projects"
						class="text-gray-800 dark:text-gray-200 underline underline-offset-2 hover:text-black dark:hover:text-white transition-colors"
						>projects page</a
					>. Available for hire.
				</p>
			</div>

			<div>
				<h2
					class="text-gray-900 dark:text-gray-100 font-semibold text-xl mb-2"
				>
					Reaching Out
				</h2>
				<p class="leading-relaxed text-gray-700 dark:text-gray-300">
					Email is best: <a
						href={`mailto:${email}`}
						class="text-gray-800 dark:text-gray-200 underline underline-offset-2 hover:text-black dark:hover:text-white transition-colors"
						>{email}</a
					>. Also on <a
						href={x}
						class="text-gray-800 dark:text-gray-200 underline underline-offset-2 hover:text-black dark:hover:text-white transition-colors"
						>𝕏</a
					>, <a
						href={linkedin}
						class="text-gray-800 dark:text-gray-200 underline underline-offset-2 hover:text-black dark:hover:text-white transition-colors"
						>LinkedIn</a
					>, and <a
						href={github}
						class="text-gray-800 dark:text-gray-200 underline underline-offset-2 hover:text-black dark:hover:text-white transition-colors"
						>GitHub</a
					>.
				</p>
			</div>

			<hr class="border-black/10 dark:border-white/10" />

			<div class="grid sm:grid-cols-2 gap-6">
				<div>
					<h2
						class="text-gray-900 dark:text-gray-100 font-semibold text-xl mb-2"
					>
						What's the icon?
					</h2>
					<p
						class="leading-relaxed text-gray-700 dark:text-gray-300 text-sm"
					>
						A moon. I like <a
							href="https://www.lua.org"
							class="text-gray-800 dark:text-gray-200 underline underline-offset-2 hover:text-black dark:hover:text-white transition-colors"
							>Lua</a
						> and it makes for a simple icon.
					</p>
				</div>
				<div>
					<h2
						class="text-gray-900 dark:text-gray-100 font-semibold text-xl mb-2"
					>
						What's "Oncelock"?
					</h2>
					<p
						class="leading-relaxed text-gray-700 dark:text-gray-300 text-sm"
					>
						A <a
							href="https://doc.rust-lang.org/std/sync/struct.OnceLock.html"
							class="text-gray-800 dark:text-gray-200 underline underline-offset-2 hover:text-black dark:hover:text-white transition-colors"
							>synchronization primitive</a
						> from Rust.
					</p>
				</div>
			</div>
		</div>
	</div>
</Layout>

<style>
	@keyframes wave {
		0%,
		60%,
		100% {
			transform: rotate(0deg);
		}
		10%,
		30% {
			transform: rotate(14deg);
		}
		20% {
			transform: rotate(-8deg);
		}
		40% {
			transform: rotate(-4deg);
		}
		50% {
			transform: rotate(10deg);
		}
	}
	.waving-hand {
		animation: wave 2s ease-in-out;
		transform-origin: 70% 70%;
		display: inline-block;
	}
</style>
