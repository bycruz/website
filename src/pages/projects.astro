---
import Layout from "../layouts/Layout.astro";
import Tag from "../components/Tag.astro";
import PatternBackground from "../components/PatternBackground.astro";
import { getAllProjects } from "../data/projects";
import { Icon } from "astro-icon/components";

const projects = await getAllProjects();
projects.sort((a, b) => {
	const aOngoing = a.status === "Ongoing" ? 1 : 0;
	const bOngoing = b.status === "Ongoing" ? 1 : 0;

	if (aOngoing !== bOngoing) {
		return bOngoing - aOngoing;
	}

	const aStars = a.stars ?? 0;
	const bStars = b.stars ?? 0;

	if (aStars !== bStars) {
		return bStars - aStars;
	}

	return a.order - b.order;
});
---

<Layout>
	<div class="py-12 pb-20 max-w-5xl mx-auto">
		<h1 class="text-3xl font-bold mb-2">Projects</h1>
		<p class="text-gray-600 dark:text-gray-400 mb-10">Things I've built.</p>

		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
			{
				projects.map((project) => (
					<a
						href={project.link}
						class="group border border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 rounded-xl overflow-hidden flex flex-col transition-colors duration-200 bg-white/40 dark:bg-white/[0.02]"
					>
						<div class="h-44 overflow-hidden bg-black/[0.03] dark:bg-white/[0.03] flex items-center justify-center">
							{project.cover ? (
								<img
									alt={project.name}
									src={project.cover}
									loading="lazy"
									class={`${project.coverStyle ?? ""} h-full w-full object-contain`}
								/>
							) : (
								<div class="h-full w-full relative">
									<PatternBackground />
								</div>
							)}
						</div>

						<div class="p-5 flex flex-col flex-1 gap-3">
							<div class="flex items-start justify-between gap-2">
								<h2 class="font-semibold text-lg group-hover:text-black dark:group-hover:text-white transition-colors leading-tight">
									{project.name}
									{project.stealth && (
										<span
											class="ml-1 text-base"
											title="Private Project"
										>
											🕵️
										</span>
									)}
								</h2>
								<div class="flex items-center gap-2 flex-shrink-0">
									{project.stars && (
										<span class="flex items-center gap-1 text-gray-500 dark:text-gray-400 text-sm font-medium">
											<Icon name="mdi:star" size="14" />
											{project.stars}
										</span>
									)}
									{project.status && (
										<span
											class={`px-2 py-0.5 text-xs font-medium rounded-full whitespace-nowrap ${
												project.status === "Ongoing" ||
												project.status === "Hiatus"
													? "bg-black/5 dark:bg-white/10 text-gray-700 dark:text-gray-200 border border-black/10 dark:border-white/15"
													: project.status ===
														  "Complete"
														? "bg-black/5 dark:bg-white/10 text-gray-700 dark:text-gray-200 border border-black/10 dark:border-white/15"
														: "bg-black/5 dark:bg-white/10 text-gray-700 dark:text-gray-200 border border-black/10 dark:border-white/15"
											}`}
										>
											{project.status}
										</span>
									)}
								</div>
							</div>

							<p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
								{project.desc}
							</p>

							{project.tags && project.tags.length > 0 && (
								<div class="flex flex-wrap gap-1.5 mt-auto pt-1">
									{project.tags.map((tag) => (
										<div class="small-tag">
											<Tag text={tag} />
										</div>
									))}
								</div>
							)}
						</div>
					</a>
				))
			}
		</div>
	</div>
</Layout>

<style>
	.small-tag :global(span) {
		padding: 0.2rem 0.4rem;
		font-size: 0.7rem;
	}
	.small-tag :global(.icon) {
		width: 11px;
		height: 11px;
	}
</style>
